# ==== Jelly Potter Kasir — konfigurasi produksi (VPS + Docker) ====
# Salin jadi .env:  cp .env.production.example .env  lalu isi bagian bertanda <<ISI>>.

APP_NAME="Jelly Potter Kasir"
APP_ENV=production
APP_DEBUG=false
# <<ISI>> buat di VPS dengan: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# <<ISI>> domain tanpa https:// (mis. kasir.jellypotter.id). Belum punya domain: isi :80
APP_DOMAIN=kasir.contoh.com
# <<ISI>> alamat lengkap aplikasi (https://domain, atau http://IP-VPS bila belum ada domain)
APP_URL=https://kasir.contoh.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=jelly_potter_kasir
DB_USERNAME=jellypotter
# <<ISI>> password acak yang panjang (mis. hasil: openssl rand -base64 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
# true jika memakai domain + HTTPS. Isi false jika sementara diakses lewat http://IP-VPS (kalau tidak, login gagal).
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

MAIL_MAILER=log

# Opsional: token gateway WhatsApp (mis. Fonnte) untuk laporan harian otomatis ke HP owner.
OWNER_NOTIFY_TOKEN=
